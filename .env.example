# Configuration reference; Java does not import this file automatically.
GOLD_AUTH_USERNAME=admin
GOLD_AUTH_PASSWORD=
GOLD_AUTH_POW_BITS=18
GOLD_AUTH_COOKIE_SECURE=false
GOLD_MARKET_ENABLED=true
GOLD_NEWS_ENABLED=true
GOLD_RESEARCH_AUTOMATIC=false
GOLD_INITIAL_BALANCE=1000
# Empty uses the public Gate contract taker fee; authenticated personal fees remain unverified.
GOLD_TAKER_FEE_RATE=
GOLD_GATE_ENABLED=true
GOLD_GATE_HTTP_URL=https://api.gateio.ws/api/v4
GOLD_GATE_WS_URL=wss://fx-ws.gateio.ws/v4/ws/usdt
# Backend-only credentials; store outside the source repository or inject a Kubernetes Secret.
GOLD_GATE_API_KEY=
GOLD_GATE_API_SECRET=
GOLD_NEWS_POLL_SECONDS=30
GOLD_EXECUTION_DELAY_MS=250
GOLD_SHORT_STAGE_SECONDS=120
GOLD_LONG_STAGE_SECONDS=180
GOLD_JUDGE_STAGE_SECONDS=180
GOLD_RESEARCH_INTERVAL_SECONDS=300
# For the deep profile, use LONG and a 300-second stage wait.
ANY2API_MINMAX_API_KEY=
ANY2API_GROK_WEB_API_KEY=
ANY2API_LONGCAT_API_KEY=
ANY2API_MIMO_API_KEY=
ANY2API_GLM_API_KEY=
